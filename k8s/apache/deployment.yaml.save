apiVersion: apps/v1
kind: Deployment

metadata:
 name: apache-deployment
 namespace: demo-apps

spec:
 replicas: 2
 selector:
  matchLabels:
    app: apache
 template:
  metadata:
   labels:
    app: apache
  spec:
   containers:
    - name: apache
      image: httpd:latest
      ports:
       - containerPort: 80
cat k8s/apache/deployment.yaml 
apiVersion: apps/v1
kind: Deployment

metadata:
 name: apache-deployment
 namespace: demo-apps

spec:
 replicas: 2
 selector:
  matchLabels:
    app: apache
 template:
  metadata:
   labels:
    app: apache
  spec:
   containers:
    - name: apache
      image: httpd:latest
      ports:
       - containerPort: 80

